# Copy to .env.local and fill in. .env.local is git-ignored; never commit credentials.

# PotionUI instance used for development
POTIONUI_URL=http://localhost:26730
POTIONUI_USER=
POTIONUI_PASSWORD=

# Docker container running PotionUI (name or id). Leave empty when PotionUI runs natively.
POTIONUI_CONTAINER=

# Local PotionUI checkout: frontend build toolchain (content/plugins) and mirror-copy target
POTIONUI_SRC=

# Non-admin test accounts used by the manual checks (created on the dev instance;
# one in a group whose content policy is "allowed", one in a "blocked" group)
POTIONUI_MB_TEST_OPEN_ID=
POTIONUI_MB_TEST_OPEN_GROUP_ID=
POTIONUI_MB_TEST_OPEN_PASSWORD=
POTIONUI_MB_TEST_BLOCKED_ID=
POTIONUI_MB_TEST_BLOCKED_GROUP_ID=
POTIONUI_MB_TEST_BLOCKED_PASSWORD=
