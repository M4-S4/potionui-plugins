# Copy to .env.local and fill in. .env.local is git-ignored; never commit credentials.

# PotionUI instance used for development
POTIONUI_URL=http://localhost:26730
POTIONUI_USER=
POTIONUI_PASSWORD=

# Docker container running PotionUI (name or id). Leave empty when PotionUI runs natively.
POTIONUI_CONTAINER=

# Local PotionUI checkout: frontend build toolchain (content/plugins) and junction target
POTIONUI_SRC=
